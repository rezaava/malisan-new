                ->where('user_id', $user->id)
                ->where('course_id', $course->id)
                ->where('role_id', $teacherRole->id)
                ->exists();
                
            if (!$isOwner) {
                return response()->json([
                    'success' => false,
                    'message' => 'شما دسترسی به این درس ندارید'
