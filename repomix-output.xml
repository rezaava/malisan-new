        foreach ($azmons as $azmon) {
            $hasParticipant = Quiz::where('azmon_id', $azmon->id)->exists();
            $azmon['expire'] = $hasParticipant ? '1' : '0';
            $azmon['participant_count'] = Quiz::where('azmon_id', $azmon->id)->count();
