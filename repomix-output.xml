    border: 2px solid transparent;
    position: relative;
}

.status-item:hover {
    background: #f1f5f9;
    transform: translateY(-2px);
}

.status-item:has(input:checked) {
    border-color: #1e6f9f;
    background: #eef5fc;
    box-shadow: 0 2px 12px rgba(30, 111, 159, 0.08);
}

.status-item input[type="checkbox"] {
