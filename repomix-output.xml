}

.status-header h5 i {
    color: #1e6f9f;
}

.status-header p {
    font-size: 0.85rem;
    color: #64748b;
    margin: 0 0 0.3rem 0;
    line-height: 1.6;
}

.status-active {
    background: #dcfce7;
    color: #16a34a;
    padding: 0.1rem 0.7rem;
    border-radius: 6px;
    font-size: 0.8rem;
