    public function getScoreClassAttribute()
    {
        $classes = [
            self::SCORE_EXCELLENT => 'excellent',
            self::SCORE_GOOD => 'good',
            self::SCORE_MEDIUM => 'medium',
        ];
        return $classes[$this->score] ?? '';
    }

