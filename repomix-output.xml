<file path="public/css/style-student-profile.css">
.profile-container {
    padding: 1.5rem;
    max-width: 900px;
    margin: 0 auto;
}

.profile-card {
    background: white;
    border-radius: 24px;
    padding: 2.5rem;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.06);
    border: 1px solid #eef2f8;
}

.profile-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-bottom: 2rem;
    margin-bottom: 2rem;
    border-bottom: 2px solid #eef2f8;
}

.profile-avatar {
    position: relative;
    width: 80px;
    height: 80px;
    flex-shrink: 0;
}

.profile-avatar img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #1e6f9f;
}

.avatar-upload {
    position: absolute;
    bottom: 0;
    right: 0;
}

.upload-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #1e6f9f;
    color: white;
    cursor: pointer;
    transition: all 0.3s ease;
}

.upload-btn i {
    font-size: 0.7rem;
}

.upload-btn:hover {
    transform: scale(1.1);
    background: #0b4a6e;
}

.avatar-upload input {
    display: none;
}

.profile-name h4 {
    font-size: 1.3rem;
    font-weight: 700;
    color: #0b3b5f;
    margin: 0 0 0.2rem 0;
}

.profile-role {
    font-size: 0.85rem;
    color: #7a9cbb;
    background: #eef5fc;
    padding: 0.2rem 1rem;
    border-radius: 20px;
}

.profile-form {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
}

.form-group label {
    font-size: 0.8rem;
    font-weight: 600;
    color: #3a5f7a;
}

.input-wrapper {
    position: relative;
}

.input-icon {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: #a0bccd;
    font-size: 0.95rem;
    transition: color 0.3s ease;
}

.input-wrapper input,
.input-wrapper select {
    width: 100%;
    padding: 0.7rem 3rem 0.7rem 1rem;
    border: 2px solid #e8edf3;
    border-radius: 12px;
    font-size: 0.85rem;
    color: #1f3e4b;
    background: white;
    transition: all 0.3s ease;
    outline: none;
    box-sizing: border-box;
    appearance: none;
    -webkit-appearance: none;
}

.input-wrapper select {
    cursor: pointer;
}

.input-wrapper input:focus,
.input-wrapper select:focus {
    border-color: #1e6f9f;
    box-shadow: 0 0 0 4px rgba(30, 111, 159, 0.08);
}

.input-wrapper input:focus+.input-icon,
.input-wrapper select:focus+.input-icon {
    color: #1e6f9f;
}

.input-wrapper input::placeholder {
    color: #b8ccdb;
}

.input-wrapper select option {
    padding: 0.5rem;
}

.file-upload-wrapper {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
}

.file-upload-input {
    display: none;
}

.file-upload-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.5rem;
    background: #f1f5f9;
    border: 2px dashed #cbd5e1;
    border-radius: 12px;
    color: #1f3e4b;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s ease;
}

.file-upload-label:hover {
    border-color: #1e6f9f;
    background: #f0f7fe;
}

.file-upload-label i {
    font-size: 1.2rem;
    color: #1e6f9f;
}

.file-name {
    font-size: 0.8rem;
    color: #94a3b8;
}

.form-actions {
    display: flex;
    gap: 1rem;
    justify-content: flex-end;
    padding-top: 1.5rem;
    border-top: 2px solid #eef2f8;
    margin-top: 0.5rem;
}

.save-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 2.5rem;
    background: linear-gradient(135deg, #1e6f9f, #0b4a6e);
    color: white;
    border: none;
    border-radius: 30px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
}

.save-btn i {
    font-size: 1rem;
}

.save-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(30, 111, 159, 0.35);
}

.cancel-btn {
    padding: 0.7rem 2rem;
    background: #f1f5f9;
    color: #5f7f9c;
    border: 2px solid #e8edf3;
    border-radius: 30px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
}

.cancel-btn:hover {
    background: #e2e8f0;
}

@media (max-width: 768px) {
    .profile-container {
        padding: 1rem;
    }

    .profile-card {
        padding: 1.5rem;
        border-radius: 18px;
    }

    .profile-header {
        flex-direction: column;
        text-align: center;
        gap: 0.8rem;
    }

    .profile-name h4 {
        font-size: 1.1rem;
    }

    .form-row {
        grid-template-columns: 1fr;
        gap: 1rem;
    }

    .form-actions {
        flex-direction: column;
    }

    .save-btn,
    .cancel-btn {
        width: 100%;
        justify-content: center;
    }

    .file-upload-wrapper {
        flex-direction: column;
        align-items: stretch;
    }

    .file-upload-label {
        justify-content: center;
    }
}
