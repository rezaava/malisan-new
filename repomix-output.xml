    box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.15);
}
.add-row input[type="text"].teal:focus {
    border-color: #11998e;
    box-shadow: 0 0 0 4px rgba(17, 153, 142, 0.15);
}
.add-btn {
    color: #fff;
    border: none;
    border-radius: 10px;
    padding: 10px 20px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
}
.add-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
}
.add-btn.purple {
    background: linear-gradient(135deg, #667eea, #764ba2);
}
.add-btn.teal {
    background: linear-gradient(135deg, #11998e, #38efd7);
}
.add-btn i {
    font-size: 16px;
}
.history-title {
    font-size: 14px;
    font-weight: 700;
    color: #1a2332;
    margin-bottom: 10px;
    border-bottom: 2px solid #f0f4f9;
    padding-bottom: 8px;
}
.history-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
}
.history-table thead tr {
    background: #f8fafc;
}
.history-table.purple thead tr {
    background: #f3f0ff;
}
.history-table.teal thead tr {
    background: #e8fdf9;
}
.history-table th,
.history-table td {
    padding: 8px 12px;
    text-align: right;
    border-bottom: 1px solid #f0f4f9;
    color: #333;
}
.history-table th {
    font-weight: 700;
    font-size: 12px;
    color: #1a2332;
}
.history-table td.col-main {
    width: 65%;
    word-break: break-word;
    white-space: normal;
}
.history-table tbody tr:hover {
    background: #f8fafc;
}
.history-table .empty-row td {
    text-align: center;
    color: #aaa;
    padding: 20px;
}
.flash-message {
    display: none;
    padding: 10px 16px;
    border-radius: 8px;
    font-size: 13px;
    margin-bottom: 14px;
}
.flash-message.success {
    background: #e8f5e9;
    color: #2e7d32;
    display: block;
}
.flash-message.error {
    background: #ffebee;
    color: #c62828;
    display: block;
}
</file>

<file path="public/css/style-surveys.css">
.surveys-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 1.5rem 1.5rem 0 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid #e0e9f0;
}

.surveys-title h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: #0b3b5f;
    margin: 0 0 0.25rem 0;
}

.surveys-title p {
    font-size: 0.85rem;
    color: #7a9cbb;
    margin: 0;
}

.surveys-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    padding: 1.8rem;
}

.survey-card {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    height: 260px;
    text-decoration: none;
    display: block;
    cursor: pointer;
    transition: all 0.4s ease;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
}

.survey-card:hover {
    transform: translateY(-10px) scale(1.02);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
}

.survey-card-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.1) 0%, rgba(0, 0, 0, 0.7) 100%);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    transition: all 0.4s ease;
}

.survey-card:hover .survey-card-overlay {
    background: linear-gradient(180deg, rgba(30, 111, 159, 0.5) 0%, rgba(11, 74, 110, 0.85) 100%);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
}

.survey-icon {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 0.8rem;
}

.survey-icon i {
    font-size: 1.5rem;
    color: rgba(255, 255, 255, 0.8);
    transform: rotate(-30deg);
}

.survey-type {
    font-size: 0.7rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.6);
    background: rgba(255, 255, 255, 0.15);
    padding: 0.2rem 0.8rem;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.1);
}

.survey-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: white;
    margin: 0 0 0.3rem 0;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
}

.survey-code {
    font-size: 0.8rem;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.7);
    margin: 0 0 0.2rem 0;
}

.survey-max {
    font-size: 0.75rem;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.6);
    margin: 0 0 1.2rem 0;
}

.survey-enter-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.6rem 1.8rem;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: white;
    border-radius: 30px;
    font-size: 0.85rem;
    font-weight: 600;
    transition: all 0.3s ease;
    align-self: flex-start;
    text-decoration: none;
}

.survey-enter-btn:hover {
    background: rgba(255, 255, 255, 0.3);
    transform: scale(1.05);
    box-shadow: 0 4px 20px rgba(255, 255, 255, 0.2);
}

@media (max-width: 992px) {
    .surveys-grid {
        grid-template-columns: 1fr;
        gap: 1.5rem;
    }

    .survey-card {
        height: 220px;
    }
}

@media (max-width: 768px) {
    .surveys-header {
        margin: 1rem 1rem 0 1rem;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
    }

    .surveys-title h2 {
        font-size: 1.2rem;
    }

    .surveys-title p {
        font-size: 0.75rem;
    }

    .surveys-grid {
        padding: 1rem;
        gap: 1rem;
    }

    .survey-card {
        height: 200px;
    }

    .survey-card-overlay {
        padding: 1.5rem;
    }

    .survey-title {
        font-size: 1.1rem;
    }

    .survey-icon i {
        font-size: 1.2rem;
    }

    .survey-code,
    .survey-max {
        font-size: 0.7rem;
    }

    .survey-enter-btn {
        padding: 0.4rem 1.2rem;
        font-size: 0.75rem;
    }
}
</file>

