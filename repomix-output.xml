            $course = Course::findOrFail($request->course_id);
            
            // ==========================================
            // 1. به‌روزرسانی بارم‌بندی (Scoring)
            // ==========================================
            $scoring = Scoring::firstOrCreate(['course_id' => $course->id]);
            $scoring->update([
                'q_1' => $request->q_1 ?? $scoring->q_1,
                'q_2' => $request->q_2 ?? $scoring->q_2,
