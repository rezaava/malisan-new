    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.5rem;
}

.accordion-item {
    background: white;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    border: 2px solid #e2e8f0;
    transition: all 0.3s ease;
}

.accordion-item.active {
    border-color: #1e6f9f;
    box-shadow: 0 4px 24px rgba(30, 111, 159, 0.12);
}

.accordion-header {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 1rem 1.5rem;
    cursor: pointer;
    transition: all 0.3s ease;
    font-weight: 700;
    color: #1f3e4b;
    font-size: 0.95rem;
    background: #f8fafc;
    user-select: none;
    border-bottom: 2px solid transparent;
}

.accordion-header:hover {
    background: #f1f5f9;
}

.accordion-header i:first-child {
    color: #1e6f9f;
    font-size: 1.2rem;
    width: 26px;
    text-align: center;
}

.accordion-icon {
    margin-right: auto;
    transition: transform 0.4s ease;
    color: #94a3b8;
    font-size: 0.9rem;
}

.accordion-body {
    display: none;
    padding: 1.5rem;
    background: white;
    border-top: 2px solid #eef2f8;
    overflow: hidden;
    transition: max-height 0.4s ease, padding 0.4s ease;
    max-height: 0;
}

.accordion-body.active {
    display: block;
    max-height: 2000px;
    padding: 1.5rem;
}

.settings-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
